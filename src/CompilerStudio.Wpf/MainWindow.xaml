<Window x:Class="CompilerStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        Title="Compiler Studio"
        Width="1300" Height="820"
        MinWidth="900" MinHeight="600"
        Background="#12121E">

  <Window.Resources>

    <!-- ── Tab button (inactive) ── -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Background"   Value="Transparent"/>
      <Setter Property="Foreground"   Value="#585B70"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="FontFamily"   Value="Segoe UI"/>
      <Setter Property="Padding"      Value="14,7"/>
      <Setter Property="Margin"       Value="1,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Run button ── -->
    <Style x:Key="RunBtn" TargetType="Button">
      <Setter Property="FontSize"    Value="11"/>
      <Setter Property="FontFamily"  Value="Segoe UI"/>
      <Setter Property="FontWeight"  Value="Bold"/>
      <Setter Property="Foreground"  Value="#1E1E2E"/>
      <Setter Property="Padding"     Value="13,5"/>
      <Setter Property="Margin"      Value="3,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── DataGrid dark theme ── -->
    <Style TargetType="DataGrid">
      <Setter Property="Background"            Value="#1A1A2E"/>
      <Setter Property="Foreground"            Value="#CDD6F4"/>
      <Setter Property="BorderThickness"       Value="0"/>
      <Setter Property="GridLinesVisibility"   Value="None"/>
      <Setter Property="FontFamily"            Value="Consolas"/>
      <Setter Property="FontSize"              Value="12"/>
      <Setter Property="RowBackground"         Value="#1A1A2E"/>
      <Setter Property="AlternatingRowBackground" Value="#20203A"/>
      <Setter Property="ColumnHeaderHeight"    Value="26"/>
      <Setter Property="AutoGenerateColumns"   Value="False"/>
      <Setter Property="IsReadOnly"            Value="True"/>
      <Setter Property="CanUserResizeRows"     Value="False"/>
      <Setter Property="SelectionMode"         Value="Single"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"      Value="#2A2A4A"/>
      <Setter Property="Foreground"      Value="#89B4FA"/>
      <Setter Property="FontWeight"      Value="Bold"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Padding"         Value="8,4"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#CDD6F4"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ── Dark ListBox ── -->
    <Style x:Key="DarkList" TargetType="ListBox">
      <Setter Property="Background"    Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily"    Value="Consolas"/>
      <Setter Property="FontSize"      Value="12"/>
      <Setter Property="Foreground"    Value="#CDD6F4"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style x:Key="DarkListItem" TargetType="ListBoxItem">
      <Setter Property="Padding"          Value="8,2"/>
      <Setter Property="Background"       Value="Transparent"/>
      <Setter Property="BorderThickness"  Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="55*" MinWidth="280"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="45*" MinWidth="280"/>
    </Grid.ColumnDefinitions>

    <!-- ═══════════════════════  EDITOR  ═══════════════════════ -->
    <Grid Grid.Column="0" Background="#1E1E2E">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Editor header bar -->
      <Border Grid.Row="0" Background="#181825" Padding="14,7">
        <Grid>
          <TextBlock Text="EDITOR" Foreground="#89B4FA"
                     FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="OptimizeBox" Content="Optimize"
                      Foreground="#CDD6F4" FontFamily="Segoe UI" FontSize="11"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Optimize the quadruples for Translate and Run"/>
            <Button Content="▶ Lex"       Background="#A6E3A1"
                    Style="{StaticResource RunBtn}" Click="BtnLexical_Click"/>
            <Button Content="▶ Parse"     Background="#89B4FA"
                    Style="{StaticResource RunBtn}" Click="BtnSyntax_Click"/>
            <Button Content="▶ Translate" Background="#F38BA8"
                    Style="{StaticResource RunBtn}" Click="BtnTranslate_Click"/>
            <Button Content="▶ Run"       Background="#FAB387"
                    Style="{StaticResource RunBtn}" Click="BtnRun_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- AvalonEdit code editor -->
      <ae:TextEditor x:Name="Editor"
                     Grid.Row="1"
                     ShowLineNumbers="True"
                     LineNumbersForeground="#45475A"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#1E1E2E"
                     Foreground="#CDD6F4"
                     Padding="4,4,0,0"/>
    </Grid>

    <!-- Splitter -->
    <GridSplitter Grid.Column="1" Width="4" Background="#0D0D1A"
                  HorizontalAlignment="Stretch"/>

    <!-- ═══════════════════════  ARTIFACTS  ═══════════════════════ -->
    <Grid Grid.Column="2" Background="#1A1A2E">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- header -->
        <RowDefinition Height="Auto"/>   <!-- stats -->
        <RowDefinition Height="Auto"/>   <!-- tab row 1 -->
        <RowDefinition Height="Auto"/>   <!-- tab row 2 -->
        <RowDefinition Height="*"/>      <!-- content -->
      </Grid.RowDefinitions>

      <!-- Artifacts header bar -->
      <Border Grid.Row="0" Background="#181825" Padding="14,7">
        <TextBlock Text="ARTIFACTS" Foreground="#89B4FA"
                   FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
      </Border>

      <!-- Stats row -->
      <Border Grid.Row="1" Background="#1E1E2E" Padding="18,14,18,14"
              BorderBrush="#252540" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <StackPanel Margin="0,0,40,0">
            <TextBlock Text="Errors"    Foreground="#585B70" FontSize="10" FontFamily="Segoe UI"/>
            <TextBlock x:Name="StatErrors"    Text="0"
                       Foreground="#F38BA8" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI"/>
          </StackPanel>
          <StackPanel Margin="0,0,40,0">
            <TextBlock Text="Tokens"    Foreground="#585B70" FontSize="10" FontFamily="Segoe UI"/>
            <TextBlock x:Name="StatTokens"    Text="0"
                       Foreground="#A6E3A1" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Artifacts" Foreground="#585B70" FontSize="10" FontFamily="Segoe UI"/>
            <TextBlock x:Name="StatArtifacts" Text="0"
                       Foreground="#89B4FA" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Tab row 1 -->
      <Border Grid.Row="2" Background="#1E1E2E" Padding="8,5,8,5"
              BorderBrush="#252540" BorderThickness="0,0,0,1">
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="Btn_ParseTree" Content="Parse Tree" Tag="ParseTree" Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Quads"     Content="Quads"      Tag="Quads"     Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_FIRST"     Content="FIRST"      Tag="FIRST"     Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Grammar"   Content="Grammar"    Tag="Grammar"   Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Lexer"     Content="Lexer"      Tag="Lexer"     Style="{StaticResource TabBtn}" Click="Tab_Click"/>
        </WrapPanel>
      </Border>

      <!-- Tab row 2 -->
      <Border Grid.Row="3" Background="#1E1E2E" Padding="8,5,8,5"
              BorderBrush="#252540" BorderThickness="0,0,0,1" Margin="0,0,0,2">
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="Btn_Summary" Content="Summary" Tag="Summary" Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Errors"  Content="Errors"  Tag="Errors"  Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Tokens"  Content="Tokens"  Tag="Tokens"  Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Symbols" Content="Symbols" Tag="Symbols" Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_AST"     Content="AST"     Tag="AST"     Style="{StaticResource TabBtn}" Click="Tab_Click"/>
          <Button x:Name="Btn_Output"  Content="Output"  Tag="Output"  Style="{StaticResource TabBtn}" Click="Tab_Click"/>
        </WrapPanel>
      </Border>

      <!-- ─── Content views ─── -->
      <Grid Grid.Row="4">

        <!-- ERRORS VIEW -->
        <Border x:Name="View_Errors" Background="#1E1E2E">
          <ListBox x:Name="ErrorsList"
                   Style="{StaticResource DarkList}"
                   ItemContainerStyle="{StaticResource DarkListItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,5,0,10">
                  <TextBlock Text="{Binding Header}"
                             Foreground="#F38BA8" FontFamily="Segoe UI" FontSize="12"
                             TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SourceContext}"
                             Foreground="#45475A" FontFamily="Consolas" FontSize="12"
                             Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding Caret}"
                             Foreground="#89B4FA" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- TOKENS VIEW -->
        <Border x:Name="View_Tokens" Background="#1E1E2E" Visibility="Collapsed">
          <ListBox x:Name="TokensList"
                   Style="{StaticResource DarkList}"
                   ItemContainerStyle="{StaticResource DarkListItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Cat}"
                             Foreground="#585B70" Width="110"/>
                  <TextBlock Text="{Binding Val}"
                             Foreground="#CDD6F4"/>
                  <TextBlock Text="{Binding Loc}"
                             Foreground="#45475A" Margin="12,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- QUADS / IR VIEW -->
        <Border x:Name="View_Quads" Background="#1E1E2E" Visibility="Collapsed">
          <ListBox x:Name="QuadsList"
                   Style="{StaticResource DarkList}"
                   Foreground="#A6E3A1"
                   ItemContainerStyle="{StaticResource DarkListItem}"/>
        </Border>

        <!-- SYMBOLS VIEW -->
        <Border x:Name="View_Symbols" Background="#1E1E2E" Padding="6" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="2*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Identifiers"
                       Foreground="#585B70" FontSize="10" FontFamily="Segoe UI" Margin="4,4,0,4"/>
            <DataGrid Grid.Row="1" x:Name="SymbolGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name"  Width="*"  Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Type"  Width="60" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Value" Width="70" Binding="{Binding Value}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="Constants  /  Temp Variables"
                       Foreground="#585B70" FontSize="10" FontFamily="Segoe UI" Margin="4,10,0,4"/>
            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <ListBox Grid.Column="0" x:Name="ConstsList"
                       Style="{StaticResource DarkList}" Foreground="#FAB387"
                       ItemContainerStyle="{StaticResource DarkListItem}"/>
              <ListBox Grid.Column="1" x:Name="TempsList"
                       Style="{StaticResource DarkList}" Foreground="#CBA6F7"
                       ItemContainerStyle="{StaticResource DarkListItem}"/>
            </Grid>
          </Grid>
        </Border>

        <!-- SUMMARY VIEW -->
        <Border x:Name="View_Summary" Background="#1E1E2E" Padding="14" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="SummaryText"
                       Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" LineHeight="20"/>
          </ScrollViewer>
        </Border>

        <!-- PARSE LOG VIEW (Parse Tree tab) -->
        <Border x:Name="View_ParseLog" Background="#1E1E2E" Visibility="Collapsed">
          <ListBox x:Name="ParseLogList"
                   Style="{StaticResource DarkList}"
                   ItemContainerStyle="{StaticResource DarkListItem}"/>
        </Border>

        <!-- OUTPUT VIEW (Run) -->
        <Border x:Name="View_Output" Background="#1E1E2E" Padding="14" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="OutputText" Text="Press ▶ Run to execute the program."
                       Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" LineHeight="20"/>
          </ScrollViewer>
        </Border>

        <!-- PLACEHOLDER for FIRST / Grammar / Lexer / AST -->
        <Border x:Name="View_Placeholder" Background="#1E1E2E" Visibility="Collapsed">
          <TextBlock Text="This view is not yet implemented."
                     Foreground="#45475A" FontFamily="Segoe UI" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

      </Grid><!-- /content grid -->
    </Grid><!-- /artifacts -->

  </Grid>
</Window>
